<Window x:Class="ComputerTracker.Data.Pages.AddEditDepartmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Изменить отдел" Height="200" Width="350"
        WindowStartupLocation="CenterOwner" Background="#FF363636">
    <Grid Margin="10" Background="#FF363636">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" Text="{Binding DepartmentName, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Height="30" VerticalAlignment="Bottom">
            <Button Content="OK" Width="70" Margin="0,0,10,0" Command="{Binding SaveCommand}" IsDefault="True"
                    Background="#FF737373" Foreground="White" BorderBrush="#FF383838"/>
            <Button Content="Отмена" Width="70" IsCancel="True" Background="#FF737373" Foreground="White" BorderBrush="#FF383838"/>
        </StackPanel>
    </Grid>
</Window>
