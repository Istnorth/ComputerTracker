<Window x:Class="ComputerTracker.Pages.AddEditComputerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:val="clr-namespace:ComputerTracker.Data.Commands"
        Title="Добавить/Изменить компьютер"
        Height="260" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#FF363636">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Triggers>
                <DataTrigger Binding="{Binding (Validation.HasError),
                            RelativeSource={RelativeSource AncestorType=Window}}"
                             Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10" Background="#FF363636">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Название -->
            <RowDefinition Height="Auto"/>
            <!-- IP -->
            <RowDefinition Height="Auto"/>
            <!-- Host -->
            <RowDefinition Height="Auto"/>
            <!-- Port -->
            <RowDefinition/>
            <!-- spacer -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Название -->
        <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"
                 Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <!-- IP-адрес -->
        <TextBlock Text="IP-адрес:" Grid.Row="1" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,5">
            <TextBox.Text>
                <Binding Path="IPAddress" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                    <Binding.ValidationRules>
                        <val:IPAddressValidationRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <!-- Host -->
        <TextBlock Text="Host:" Grid.Row="2" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"
                 Text="{Binding Host, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

        <!-- Port -->
        <TextBlock Text="Port:" Grid.Row="3" Grid.Column="0"
                   VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,5">
            <TextBox.Text>
                <Binding Path="Port" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                    <Binding.ValidationRules>
                        <val:IntegerValidationRule/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="75" Margin="0,0,10,0"
                    Command="{Binding SaveCommand}" IsDefault="True"
                    Background="#FF737373" Foreground="White" BorderBrush="#FF383838"/>
            <Button Content="Отмена" Width="75" IsCancel="True"
                    Background="#FF737373" Foreground="White" BorderBrush="#FF383838"/>
        </StackPanel>
    </Grid>
</Window>
