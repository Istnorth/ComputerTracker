<Window x:Class="ComputerTracker.Data.Pages.LogRegPages.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login" Height="500" Width="500" Background="#3D3D3D" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Border Background="#3D3D3D" Width="400" Height="400" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="10" Padding="20">
            <StackPanel VerticalAlignment="Center" Height="200">
                <TextBlock Text="Authorization" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Login:" Foreground="White" FontSize="14" FontWeight="Bold" Width="100" VerticalAlignment="Center"/>
                    <TextBox Name="loginTextBox" Width="200" Background="#161616" Foreground="White" BorderThickness="1" BorderBrush="Gray" Height="25"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Password:" Foreground="White" FontSize="14" FontWeight="Bold" Width="100" VerticalAlignment="Center"/>
                    <PasswordBox Name="passwordBox" Width="200" Background="#161616" Foreground="White" BorderThickness="1" BorderBrush="Gray" Height="25"/>
                </StackPanel>

                <Button Name="loginButton" Click="LoginButton_Click" Content="Log In" Width="100" Height="35" Background="#161616" Foreground="White" BorderThickness="2" BorderBrush="#161616" FontWeight="Bold" HorizontalAlignment="Center"/>

                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Hyperlink Click="RegisterLink_Click" Foreground="White">No account?</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
