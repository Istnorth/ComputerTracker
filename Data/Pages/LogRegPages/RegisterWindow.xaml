<Window x:Class="ComputerTracker.Data.Pages.LogRegPages.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registration" Height="500" Width="500" Background="#3D3D3D" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Border Background="#3D3D3D" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="10">
            <StackPanel Margin="20">
                <TextBlock Text="Registration" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>

                <TextBlock Text="Login" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,20,0,5"/>
                <TextBox x:Name="LoginTextBox" Background="#161616" Foreground="White" BorderBrush="#161616" Height="25"/>

                <TextBlock Text="Password" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,10,0,5"/>
                <PasswordBox x:Name="PasswordBox" Background="#161616" Foreground="White" BorderBrush="#161616" Height="25"/>

                <TextBlock Text="Full Name" FontSize="14" FontWeight="Bold" Foreground="White" Margin="10,10,0,5"/>
                <TextBox x:Name="FullNameTextBox" Background="#161616" Foreground="White" BorderBrush="#161616" Height="25"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,20,10,0">
                    <Button x:Name="RegisterButton" Click="RegisterButton_Click" Content="Register" Width="100" Height="35" Background="#161616" Foreground="White" BorderBrush="#161616" FontWeight="Bold"/>
                    <Button x:Name="BackButton" Click="BackButton_Click" Content="Back" Width="100" Height="35" Background="#161616" Foreground="White" BorderBrush="#161616" FontWeight="Bold" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
