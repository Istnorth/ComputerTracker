<Page x:Class="ComputerTracker.Data.Pages.ComputersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Компьютеры" Background="#FF3A3A3A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Панель кнопок -->
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="Список компьютеров" FontSize="20" Margin="0,0,0,10" Foreground="White" Grid.Row="0"/>

        <!-- Основной DataGrid с данными компьютеров -->
        <DataGrid ItemsSource="{Binding Computers}"
          AutoGenerateColumns="False"
          Margin="0,0,0,10"
          Background="#FF363636"
          Grid.Row="1"
          SelectedItem="{Binding SelectedComputer}">
            <DataGrid.Columns>
                <!-- Базовые поля -->
                <DataGridTextColumn Header="Имя" Binding="{Binding ComputerName}" Width="150"/>
                <DataGridTextColumn Header="IP-адрес" Binding="{Binding IPAddress}" Width="120"/>
                <DataGridTextColumn Header="Хост" Binding="{Binding Host}" Width="120"/>
                <DataGridTextColumn Header="Порт" Binding="{Binding Port}" Width="80"/>
                <DataGridTextColumn Header="Последнее обновление"
                             Binding="{Binding LastUpdated, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                             Width="150"/>

                <DataGridTextColumn Header="OS Caption"
                             Binding="{Binding LatestSystemData.OSCaption}"
                             Width="200"/>
                <DataGridTextColumn Header="Производитель ОС"
                             Binding="{Binding LatestSystemData.OSManufacturer}"
                             Width="150"/>
                <DataGridTextColumn Header="Расположение Windows"
                             Binding="{Binding LatestSystemData.WindowsDirectory}"
                             Width="200"/>

                <DataGridTextColumn Header="Ядра CPU"
                             Binding="{Binding LatestSystemData.CpuCores}"
                             Width="80"/>
                <DataGridTextColumn Header="Потоки CPU"
                             Binding="{Binding LatestSystemData.CpuThreads}"
                             Width="80"/>
                <DataGridTextColumn Header="Частота MHz"
                             Binding="{Binding LatestSystemData.CpuClockMHz}"
                             Width="100"/>
                
                <DataGridTextColumn Header="GPU‑адаптеры"
                             Binding="{Binding Gpus.Count}"
                             Width="80"/>
                <DataGridTextColumn Header="Клавиатуры"
                             Binding="{Binding Keyboards.Count}"
                             Width="80"/>
                <DataGridTextColumn Header="Мыши"
                             Binding="{Binding Mice.Count}"
                             Width="80"/>
                <DataGridTextColumn Header="Принтеры"
                             Binding="{Binding Printers.Count}"
                             Width="80"/>
                <DataGridTextColumn Header="Сканеры"
                             Binding="{Binding Scanners.Count}"
                             Width="80"/>
                <DataGridTextColumn Header="Мониторы"
                             Binding="{Binding Monitors.Count}"
                             Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель кнопок управления -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="10">
            <Button Content="Добавить" Margin="0,0,10,0" Command="{Binding AddComputerCommand}"/>
            <Button Content="Редактировать" Margin="0,0,10,0" Command="{Binding EditComputerCommand}"
              IsEnabled="{Binding SelectedComputer, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="Удалить" Margin="0,0,10,0" Command="{Binding DeleteComputerCommand}"
              IsEnabled="{Binding SelectedComputer, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="Обновить системные данные" Command="{Binding UpdateSystemDataCommand}"
              IsEnabled="{Binding SelectedComputer, Converter={StaticResource NullToBooleanConverter}}"/>
        </StackPanel>
    </Grid>
</Page>
