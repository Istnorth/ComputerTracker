<Page x:Class="ComputerTracker.Data.Pages.ComputersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Компьютеры" Background="#FF3A3A3A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Панель кнопок -->
        </Grid.RowDefinitions>

        <!-- Заголовок страницы -->
        <TextBlock Text="Список компьютеров" FontSize="20" Margin="0,0,0,10" Foreground="White" Grid.Row="0"/>

        <!-- Основной DataGrid с данными компьютеров -->
        <DataGrid ItemsSource="{Binding Computers}" AutoGenerateColumns="False" Margin="0,0,0,10" Background="#FF363636"
          Grid.Row="1" SelectedItem="{Binding SelectedComputer}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding ComputerName}" Width="150"/>
                <DataGridTextColumn Header="IP-адрес" Binding="{Binding IPAddress}" Width="120"/>
                <DataGridTextColumn Header="Последнее обновление" Binding="{Binding LastUpdated, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="150"/>
                <DataGridTextColumn Header="CPU (%)" Binding="{Binding LatestSystemData.CPUUsage}" Width="160"/>
                <DataGridTextColumn Header="Память (%)" Binding="{Binding LatestSystemData.MemoryUsage, StringFormat=N2}" Width="160"/>
                <DataGridTextColumn Header="Диск (%)" Binding="{Binding LatestSystemData.DiskUsage, StringFormat=N2}" Width="160"/>
                <DataGridTextColumn Header="Сеть (Мбит/с)" Binding="{Binding LatestSystemData.NetworkUsage, StringFormat=N2}" Width="160"/>
                <DataGridTextColumn Header="OS" Binding="{Binding LatestSystemData.OSVersion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель кнопок управления -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="10">
            <Button Content="Добавить" Margin="0,0,10,0" Command="{Binding AddComputerCommand}"/>
            <Button Content="Редактировать" Margin="0,0,10,0" Command="{Binding EditComputerCommand}"
              IsEnabled="{Binding SelectedComputer, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="Удалить" Margin="0,0,10,0" Command="{Binding DeleteComputerCommand}"
              IsEnabled="{Binding SelectedComputer, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="Обновить системные данные" Command="{Binding UpdateSystemDataCommand}"
              IsEnabled="{Binding SelectedComputer, Converter={StaticResource NullToBooleanConverter}}"/>
        </StackPanel>
    </Grid>
</Page>
