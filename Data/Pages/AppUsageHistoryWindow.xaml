<Window x:Class="ComputerTracker.Data.Pages.AppUsageHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История процессов" Height="800" Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <DataGrid ItemsSource="{Binding Entries}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Заголовок окна" Binding="{Binding WindowTitle}" Width="*"/>
                <DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
