<Page x:Class="ComputerTracker.Data.Pages.DepartmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отделы" Background="#FF3A3A3A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Панель кнопок -->
        </Grid.RowDefinitions>

        <TextBlock Text="Список отделов" FontSize="20" Foreground="White" Grid.Row="0" Margin="0,0,0,10"/>

        <DataGrid ItemsSource="{Binding Departments}" AutoGenerateColumns="False" Grid.Row="1" Background="#FF363636" Margin="0,0,0,10"
              SelectedItem="{Binding SelectedDepartment}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding DepartmentID}" Width="Auto"/>
                <DataGridTextColumn Header="Название отдела" Binding="{Binding DepartmentName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель кнопок управления -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="10">
            <Button Content="Добавить" Margin="0,0,10,0" Command="{Binding AddDepartmentCommand}"/>
            <Button Content="Редактировать" Margin="0,0,10,0" Command="{Binding EditDepartmentCommand}"
              IsEnabled="{Binding SelectedDepartment, Converter={StaticResource NullToBooleanConverter}}"/>
            <Button Content="Удалить" Command="{Binding DeleteDepartmentCommand}"
              IsEnabled="{Binding SelectedDepartment, Converter={StaticResource NullToBooleanConverter}}"/>
        </StackPanel>
    </Grid>
</Page>
