<Window x:Class="ComputerTracker.Data.Pages.KeyLogHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История ввода клавиш" Height="800" Width="800">
    <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False" Margin="10">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Время" Binding="{Binding Time, StringFormat={}{0:dd.MM.yyyy HH:mm:ss}}" Width="150"/>
            <DataGridTextColumn Header="Клавиша" Binding="{Binding Key}" Width="*"/>
        </DataGrid.Columns>
    </DataGrid>
</Window>
