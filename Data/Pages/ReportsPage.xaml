<Page x:Class="ComputerTracker.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчеты" Background="#FF3A3A3A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель фильтров -->
            <RowDefinition Height="*"/>
            <!-- Область отчета -->
            <RowDefinition Height="Auto"/>
            <!-- Панель управления -->
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Дата начала:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding ReportStartDate, Mode=TwoWay}" />
            <TextBlock Text="Дата окончания:" Foreground="White" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker SelectedDate="{Binding ReportEndDate, Mode=TwoWay}" />
            <TextBlock Text="Тип отчета:" Foreground="White" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <ComboBox ItemsSource="{Binding ReportTypes}" 
                SelectedItem="{Binding ReportType, Mode=TwoWay}"
                Width="120" Margin="0,0,5,0"/>

            <ComboBox Width="150" Margin="10,0,0,0"
                ItemsSource="{Binding Computers}"
                SelectedItem="{Binding SelectedComputer, Mode=TwoWay}"
                DisplayMemberPath="ComputerName">
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportType}" Value="Компьютер">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>
            <Button Content="Сформировать отчет" Margin="10,0,0,0" Command="{Binding GenerateReportCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ReportItems}" AutoGenerateColumns="True" Background="#FF363636" />

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Экспорт в Excel" Command="{Binding ExportReportCommand}" />
        </StackPanel>
    </Grid>
</Page>
