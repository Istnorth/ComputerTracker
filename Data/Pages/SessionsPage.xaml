<Page x:Class="ComputerTracker.Data.Pages.SessionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сессии использования"
      Background="#FF3A3A3A">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- фильтры -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- кнопки -->
        </Grid.RowDefinitions>

        <!-- Фильтры даты -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Дата начала:" Foreground="White" VerticalAlignment="Center"/>
            <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}" Margin="5,0"/>
            <TextBlock Text="Дата окончания:" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}" Margin="5,0"/>
            <Button Content="Применить фильтр" Command="{Binding FilterCommand}" Margin="10,0"/>
        </StackPanel>

        <!-- Список сессий -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}"
                  AutoGenerateColumns="False"
                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                  CanUserAddRows="False" IsReadOnly="True"
                  Background="#FF363636">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding SessionID}" Width="50"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.FullName}" Width="150"/>
                <DataGridTextColumn Header="Компьютер" Binding="{Binding Computer.ComputerName}" Width="150"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140"/>
                <DataGridTextColumn Header="Длительность (мин)" Binding="{Binding Duration}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" Command="{Binding AddSessionCommand}" Margin="0,0,10,0"/>
            <Button Content="Редактировать" Command="{Binding EditSessionCommand}" 
                    IsEnabled="{Binding SelectedSession, Converter={StaticResource NullToBooleanConverter}}" Margin="0,0,10,0"/>
            <Button Content="Удалить" Command="{Binding DeleteSessionCommand}"
                    IsEnabled="{Binding SelectedSession, Converter={StaticResource NullToBooleanConverter}}" Margin="0,0,10,0"/>
            <Button Content="История процессов" Command="{Binding ShowAppUsageHistoryCommand}"
                    IsEnabled="{Binding SelectedSession, Converter={StaticResource NullToBooleanConverter}}" Margin="0,0,10,0"/>
            <Button Content="История ввода клавиш" Command="{Binding ShowKeyLogHistoryCommand}"
                    IsEnabled="{Binding SelectedSession, Converter={StaticResource NullToBooleanConverter}}" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Page>
