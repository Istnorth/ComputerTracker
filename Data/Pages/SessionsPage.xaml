<Page x:Class="ComputerTracker.Data.Pages.SessionsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сессии использования">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель фильтров -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Панель управления -->
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Дата начала:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker SelectedDate="{Binding FilterStartDate, Mode=TwoWay}" />
            <TextBlock Text="Дата окончания:" Foreground="White" VerticalAlignment="Center" Margin="10,0,5,0"/>
            <DatePicker SelectedDate="{Binding FilterEndDate, Mode=TwoWay}" />
            <Button Content="Применить фильтр" Margin="10,0,0,0" Command="{Binding FilterCommand}" />
        </StackPanel>


        <!-- DataGrid со списком сессий -->
        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding Sessions}" 
              CanUserAddRows="False" IsReadOnly="False" SelectedItem="{Binding SelectedSession, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
              IsSynchronizedWithCurrentItem="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding SessionID}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Сотрудник" Binding="{Binding Employee.FullName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Компьютер" Binding="{Binding Computer.ComputerName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                <DataGridTextColumn Header="Длительность (мин)" Binding="{Binding Duration}" IsReadOnly="True" Width="auto"/>

                <DataGridTemplateColumn Header="Приложения" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding SoftwareUsages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Software.SoftwareName}" />
                                            <Run Text=" (" />
                                            <Run Text="{Binding Duration}" />
                                            <Run Text=" мин)" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель управления -->
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Добавить" Margin="0,0,10,0" Command="{Binding AddSessionCommand}" />
            <Button Content="Редактировать" Margin="0,0,10,0" Command="{Binding EditSessionCommand}" />
            <Button Content="Удалить" Command="{Binding DeleteSessionCommand}" Margin="0,0,10,0" />
            <Button Content="Начать мониторинг ПО" Command="{Binding StartMonitoringCommand}" Margin="0,0,10,0"/>
            <Button Content="Остановить мониторинг ПО" Command="{Binding StopMonitoringCommand}"/>
        </StackPanel>
    </Grid>
    </Page>
