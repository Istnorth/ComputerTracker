<Window x:Class="ComputerTracker.Pages.AddEditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить/Изменить сотрудника" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" Background="#FF363636">
    <Grid Margin="10" Background="#FF363636">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Имя сотрудника -->
        <TextBlock Text="Имя:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Фамилия сотрудника -->
        <TextBlock Text="Фамилия:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,5" Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Отчество сотрудника -->
        <TextBlock Text="Отчество:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,5" Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Выбор отдела -->
        <TextBlock Text="Отдел:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,5,5" Foreground="White"/>
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"
                  ItemsSource="{Binding Departments}" 
                  DisplayMemberPath="DepartmentName" 
                  SelectedItem="{Binding SelectedDepartment}"/>

        <!-- Панель кнопок OK / Отмена -->
        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" VerticalAlignment="Bottom" Height="30">
            <Button Content="OK" Width="70" Margin="0,0,10,0" Command="{Binding SaveCommand}" IsDefault="True"
                    Background="#FF737373" Foreground="White" BorderBrush="#FF383838"/>
            <Button Content="Отмена" Width="70" IsCancel="True" Background="#FF737373" Foreground="White" BorderBrush="#FF383838"/>
        </StackPanel>
    </Grid>
</Window>
