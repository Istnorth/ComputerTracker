<Window x:Class="ComputerTracker.Data.Pages.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автоматизированное рабочее место системного администратора" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" WindowState="Maximized">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="#545454">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="АРМСА" FontSize="24" Foreground="White" Margin="10,0,10,0" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Выйти" Margin="10,0,10,0" Command="{Binding LogoutCommand}"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" Grid.Column="0" Name="NavigationListBox" Background="#FF3A3A3A" 
                 SelectionChanged="NavigationListBox_SelectionChanged">
            <ListBoxItem Content="Компьютеры" Foreground="White"/>
            <ListBoxItem Content="Сотрудники" Foreground="White"/>
            <ListBoxItem Content="Отделы" Foreground="White"/>
            <ListBoxItem Content="Сессии" Foreground="White"/>
            <ListBoxItem Content="Отчёты" Foreground="White"/>
        </ListBox>

        <Frame Grid.Row="1" Grid.Column="1" Name="MainFrame" NavigationUIVisibility="Hidden" Background="#FF3A3A3A"/>

        <StatusBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#545454">
            <StatusBarItem Content="{Binding StatusMessage}"/>
        </StatusBar>
    </Grid>
</Window>